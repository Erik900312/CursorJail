<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CursorJail.ico</ApplicationIcon>
    <AssemblyName>CursorJail</AssemblyName>
    <RootNamespace>CursorJail</RootNamespace>
    <Version>0.1.0</Version>
    <Product>CursorJail</Product>
    <Description>A visual cursor cage for Windows and ultrawide monitors.</Description>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- WPF owns startup/DPI; WinForms is only used for NotifyIcon. Keep the PMv2 manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CursorJail.Core\CursorJail.Core.csproj" />
    <Resource Include="Assets\CursorJail.ico" />
  </ItemGroup>
</Project>
