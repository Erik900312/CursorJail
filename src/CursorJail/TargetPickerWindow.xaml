<Window x:Class="CursorJail.TargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorJail · Pick a window" WindowStyle="None" AllowsTransparency="True"
        Background="#05001008" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Cursor="Cross" MouseLeftButtonUp="Pick" PreviewKeyDown="KeyPressed">
  <Grid>
    <Border Background="#F0101B19" BorderBrush="#91F2C3" BorderThickness="1" CornerRadius="12"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20" IsHitTestVisible="False">
      <StackPanel>
        <TextBlock Text="ATTACH TO A WINDOW" FontWeight="Bold" Foreground="#91F2C3" FontSize="11" HorizontalAlignment="Center" />
        <TextBlock Text="Click your game window" FontSize="23" Foreground="#F1F5FA" Margin="0,8,0,6" HorizontalAlignment="Center" />
        <TextBlock Text="Esc cancels · The selection click is consumed" Foreground="#A5B1C2" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
